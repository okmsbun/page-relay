{
    "manifest_version": 3,
    "name": "Page capture",
    "version": "0.1.0",
    "description": "Capture a page screenshot and text, then choose an AI conversation.",
    "action": {
        "default_title": "Page capture",
        "default_popup": "popup.html"
    },
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://deepseek.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://poe.com/*",
        "https://www.poe.com/*"
    ],
    "permissions": [
        "activeTab",
        "scripting"
    ]
}
