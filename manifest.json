{
    "manifest_version": 3,
    "name": "PageRelay",
    "version": "0.1.0",
    "minimum_chrome_version": "116",
    "description": "Capture a full-page screenshot and rendered page text, then prepare that context in a supported AI chat.",
    "action": {
        "default_title": "PageRelay",
        "default_icon": {
            "16": "assets/icons/icon-16.png",
            "32": "assets/icons/icon-32.png",
            "48": "assets/icons/icon-48.png",
            "128": "assets/icons/icon-128.png"
        }
    },
    "icons": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "service-worker.js"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "permissions": [
        "scripting",
        "sidePanel",
        "storage",
        "tabs"
    ]
}